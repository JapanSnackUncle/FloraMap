{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flora-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "flora-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "flora-pages-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--base=/FloraMap/",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    }
  ]
}
